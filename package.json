{
  "name": "summapass",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=2 tests/*.test.ts tests/*.test.mjs",
    "supabase:check": "node scripts/supabase-check.mjs",
    "supabase:smoke": "tsx scripts/supabase-smoke.ts",
    "dev:web": "next dev --webpack --hostname 127.0.0.1",
    "notifications:worker": "node scripts/notification-worker.mjs",
    "notifications:once": "node scripts/notification-worker.mjs --once",
    "supabase:operations:smoke": "tsx scripts/supabase-operations-smoke.ts"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/pdfkit": "^0.17.7",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0"
  }
