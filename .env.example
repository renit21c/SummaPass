SUMMAPASS_AUTH_MODE=demo
# Set true on HTTPS deployments. False only for local HTTP preview.
SUMMAPASS_COOKIE_SECURE=false
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Required for server operations and request limits in Supabase mode. Server-only.
SUPABASE_SERVICE_ROLE_KEY=
# Stable 32-byte encryption key encoded as 64 hex characters. Keep private.
SUMMAPASS_TICKET_KEY_V1=

# See docs/SUPABASE_INTEGRATION.md for staging account variables.
# Remote smoke tests create fictional event/transaction records and are opt-in.
SUMMAPASS_ALLOW_REMOTE_TESTS=false

# Notification worker and email. Server-only; never prefix these keys NEXT_PUBLIC_.
# Reminder scheduling works without an email provider. Email stays queued when disabled.
SUMMAPASS_CRON_SECRET=
# Full origin only. Production example: https://summapass.vercel.app
SUMMAPASS_APP_URL=http://127.0.0.1:3000
SUMMAPASS_EMAIL_ENABLED=false
SUMMAPASS_EMAIL_FROM=
RESEND_API_KEY=

# Local dev automatically starts the worker in Supabase mode.
SUMMAPASS_LOCAL_WORKER_ENABLED=true
# Standalone worker target. npm run dev sets this to the actual selected port.
SUMMAPASS_WORKER_URL=http://127.0.0.1:3000
# Resend webhook endpoint signing secret, not the API key.
RESEND_WEBHOOK_SECRET=

# Leave empty for localhost. In production, set ONLY when your trusted reverse
# proxy overwrites this header, blocking clients from providing their own value.
# Supported: x-forwarded-for, x-real-ip, cf-connecting-ip. See docs/REQUEST_LIMITS.md.
SUMMAPASS_TRUSTED_IP_HEADER=
