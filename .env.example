SUMMAPASS_AUTH_MODE=demo
# Set true on HTTPS deployments. False only for local HTTP preview.
SUMMAPASS_COOKIE_SECURE=false
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Required for payment/ticket issuance only in Supabase mode. Server-only keys.
SUPABASE_SERVICE_ROLE_KEY=
# Stable 32-byte encryption key encoded as 64 hex characters. Keep private.
SUMMAPASS_TICKET_KEY_V1=

# See docs/SUPABASE_INTEGRATION.md for staging account variables.
# Remote smoke tests create fictional event/transaction records and are opt-in.
SUMMAPASS_ALLOW_REMOTE_TESTS=false
